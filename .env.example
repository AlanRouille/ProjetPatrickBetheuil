# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB_NAME?sslmode=require"

# Optionnel en local : si EMAIL_USER ou EMAIL_PASS manque, l'e-mail est affiche
# dans la console du serveur `npm run dev` au lieu d'etre envoye.
EMAIL_USER="pbetheuil.art@gmail.com"
EMAIL_PASS=""
EMAIL_RECEIVER="pbetheuil.art@gmail.com"
EMAIL_FROM="Patrick Betheuil <commandes@votre-domaine.fr>"
ORDER_NOTIFICATION_EMAIL="pbetheuil.art@gmail.com"

# Recommandé en production pour les e-mails transactionnels.
# Si RESEND_API_KEY est absent, le site utilise EMAIL_USER/EMAIL_PASS.
RESEND_API_KEY=""

# Admin
AUTH_SECRET="generate-a-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Necessaire seulement pour tester le paiement Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# URL publique sans slash final, utilisée pour les retours Stripe.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
